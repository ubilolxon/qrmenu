# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

APP_ENV=dev
LOG_LEVEL=debug

HTTP_ADDR=:8080
# Prometheus scrape endpoint, on its own listener so it is not reachable from
# the port behind the load balancer. Must differ from HTTP_ADDR; empty disables
# it. Nothing authenticates it — the boundary being relied on is the network.
METRICS_ADDR=:9091
# Origins allowed to call the admin API. The SPA dev server goes here.
# '*' is rejected outside dev because the refresh cookie is credentialed.
HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_SHUTDOWN_TIMEOUT=30s

# Port 5433 matches deploy/docker-compose.yml, which avoids colliding with a
# Postgres installed directly on the host.
#
# NOTE: this connects as the *owner*, which is what migrations need and what
# row-level security does not apply to. The standard Postgres image makes
# POSTGRES_USER a superuser, so running the API as this user silently disables
# the RLS backstop — the API warns about it in dev and refuses to start
# elsewhere. Create the application role once, after migrating:
#
#   make migrate
#   make db-role password=…
#
# and then point the API at postgres://qrmenu_app:…@localhost:5433/qrmenu.
DATABASE_URL=postgres://qrmenu:qrmenu@localhost:5433/qrmenu?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Signing key for access tokens. Required outside dev, minimum 32 characters.
# In dev a random one is generated when unset, but then every restart
# invalidates issued tokens — hence this fixed local value.
# Generate a real one with: openssl rand -base64 48
AUTH_JWT_SECRET=local-dev-secret-at-least-32-characters-long
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_NAME=qrmenu_refresh
AUTH_COOKIE_PATH=/api/v1/admin/auth
# Secure cookies need HTTPS; defaults to false in dev, true elsewhere.
AUTH_COOKIE_SECURE=false

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=qrmenu
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000/qrmenu

# The address a guest's phone can actually reach — this is what QR codes encode
# and what printed cards show, so it must not be the internal listen address.
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_CACHE_MAX_AGE=60s
PUBLIC_STALE_WHILE_REVALIDATE=300s

# Ties an anonymous guest to the orders they placed. It is the only credential
# in that flow, and it outlives a meal by a wide margin without carrying for a
# year on a shared phone.
PUBLIC_GUEST_COOKIE_NAME=qrmenu_guest
PUBLIC_GUEST_SESSION_TTL=168h

# --- billing ---------------------------------------------------------------
# How long an unpaid subscription keeps working after its period ends, before
# it is suspended. Long enough for a bank transfer to clear over a weekend.
BILLING_GRACE_PERIOD=72h
# How often the expiry pass runs. Lower it in a test environment to watch a
# suspension happen without waiting a day.
BILLING_SWEEP_INTERVAL=24h
# Shown at checkout when payment is by transfer. Per-business, so it is
# configuration rather than a constant.
BILLING_MANUAL_INSTRUCTIONS=

# Payme Merchant API. Both must be set, or neither: a merchant id with no key
# would send customers to a checkout whose callbacks we could not verify, which
# is worse than not offering the method at all. Unset means Payme is not
# registered, and /webhooks/payme answers 404.
#
# PAYME_KEY authenticates Payme's calls to us, as the password half of HTTP
# Basic with the fixed username "Paycom". It is not the checkout secret.
PAYME_MERCHANT_ID=
PAYME_KEY=
# Override only to point at the test environment.
PAYME_CHECKOUT_URL=
